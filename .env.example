# Public (safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Local scan-bridge origin (optional companion, see scan-bridge/README.md)
NEXT_PUBLIC_SCAN_BRIDGE_URL=http://localhost:7317

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
# SMS: "mock" (console/outbox only) or "africastalking"
SMS_PROVIDER=mock
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Optional AI reading of scans (off until the Ministry approves an external processor)
AI_READING_ENABLED=false
ANTHROPIC_API_KEY=
# Bootstrap the first admin (scripts/bootstrap-admin.ts)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
# Secret shared by the cron caller for /api/cron/*
CRON_SECRET=
